// ====================================================================
// PEHCHAAN (SKIT021) - PRISMA SCHEMA
// Multi-Tenant Institutional Student Participation & Verification SaaS
// ====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------
// ENUMS
// --------------------------------------------------

enum Role {
  PLATFORM_SUPER_ADMIN
  INSTITUTION_ADMIN
  FACULTY_COORDINATOR
  STUDENT
  AUDITOR_VIEWER
}

enum InstitutionStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  INACTIVE
  ARCHIVED
}

enum ActivityStatus {
  Upcoming
  Ongoing
  Completed
  Cancelled
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  NEEDS_CORRECTION
  VERIFIED
  REJECTED
}

enum NotificationType {
  info
  success
  warning
  error
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionPlan {
  COMMUNITY_FREE
  CAMPUS_PRO
  ENTERPRISE_INSTITUTION
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// --------------------------------------------------
// 1. INSTITUTION (TENANT ROOT)
// --------------------------------------------------

model Institution {
  id            String            @id @default(cuid())
  code          String            @unique // e.g. "SKIT-021"
  name          String
  shortName     String
  portalId      String            @unique // e.g. "SKIT021-EDU-CLOUD"
  accreditation String?
  address       String?
  academicYear  String?           @default("2024 - 2025")
  status        InstitutionStatus @default(ACTIVE)
  adminEmail    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relationships
  memberships          InstitutionMembership[]
  departments          Department[]
  students             StudentProfile[]
  activities           Activity[]
  participationRecords ParticipationRecord[]
  evidenceFiles        EvidenceFile[]
  verificationReviews  VerificationReview[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  invitations          Invitation[]
  subscription         Subscription?

  @@index([status])
  @@index([code])
}

// --------------------------------------------------
// 2. USER (GLOBAL IDENTITY)
// --------------------------------------------------

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  fullName               String
  avatarUrl              String?
  phone                  String?
  isPlatformAdmin        Boolean   @default(false)
  isActive               Boolean   @default(true)
  emailVerified          Boolean   @default(false)
  verificationToken      String?
  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relationships
  memberships           InstitutionMembership[]
  studentProfile        StudentProfile?
  uploadedEvidenceFiles EvidenceFile[]          @relation("UserUploadedFiles")
  reviewsGiven          VerificationReview[]    @relation("ReviewerUser")
  auditLogs             AuditLog[]              @relation("ActorAuditLogs")
  notifications         Notification[]          @relation("UserNotifications")
  invitationsSent       Invitation[]            @relation("InvitedByUser")

  @@index([email])
}

// --------------------------------------------------
// 3. INSTITUTION MEMBERSHIP (TENANT USER ROLE)
// --------------------------------------------------

model InstitutionMembership {
  id            String           @id @default(cuid())
  institutionId String
  userId        String
  role          Role             @default(STUDENT)
  departmentId  String?
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([institutionId, userId])
  @@index([institutionId, role])
  @@index([userId])
}

// --------------------------------------------------
// 4. DEPARTMENT
// --------------------------------------------------

model Department {
  id              String   @id @default(cuid())
  institutionId   String
  code            String // e.g. "CSE"
  name            String // e.g. "Computer Science & Engineering"
  coordinatorName String?
  coordinatorEmail String?
  description     String?
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution          Institution             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  students             StudentProfile[]
  activities           Activity[]
  participationRecords ParticipationRecord[]
  memberships          InstitutionMembership[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

// --------------------------------------------------
// 5. STUDENT PROFILE
// --------------------------------------------------

model StudentProfile {
  id            String        @id @default(cuid())
  institutionId String
  userId        String?       @unique // Optional link to User login
  studentId     String // Human-readable roll number, e.g. "SKIT-2022-CS014"
  name          String
  email         String
  departmentId  String
  program       String // e.g. "B.Tech Computer Science"
  year          String // e.g. "3rd Year"
  status        StudentStatus @default(ACTIVE)
  avatar        String?
  phone         String?
  cgpa          String?
  bio           String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  institution          Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  participationRecords ParticipationRecord[]

  @@unique([institutionId, studentId])
  @@unique([institutionId, email])
  @@index([institutionId, departmentId])
  @@index([institutionId, status])
}

// --------------------------------------------------
// 6. ACTIVITY
// --------------------------------------------------

model Activity {
  id              String         @id @default(cuid())
  institutionId   String
  code            String // e.g. "ACT-101"
  name            String
  category        String // e.g. Technical, Sports, Cultural
  description     String
  departmentId    String
  startDate       DateTime
  endDate         DateTime
  venue           String
  mode            String         @default("In-Person") // In-Person, Hybrid, Virtual
  coordinator     String
  status          ActivityStatus @default(Upcoming)
  maxParticipants Int            @default(100)
  isArchived      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution          Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  participationRecords ParticipationRecord[]

  @@unique([institutionId, code])
  @@index([institutionId, category])
  @@index([institutionId, status])
  @@index([institutionId, departmentId])
}

// --------------------------------------------------
// 7. PARTICIPATION RECORD
// --------------------------------------------------

model ParticipationRecord {
  id                 String             @id @default(cuid())
  institutionId      String
  recordNumber       String // e.g. "REC-2024-001"
  studentProfileId   String
  activityId         String
  departmentId       String
  category           String
  participationDate  DateTime
  achievementLevel   String // Winner, Runner-up, Finalist, Recognition, Participant
  certificateRef     String?
  description        String
  verificationStatus VerificationStatus @default(PENDING_REVIEW)
  submissionDate     DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  institution    Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentProfile StudentProfile       @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  activity       Activity             @relation(fields: [activityId], references: [id], onDelete: Restrict)
  department     Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  evidenceFiles  EvidenceFile[]
  reviews        VerificationReview[]

  @@unique([institutionId, recordNumber])
  @@index([institutionId, verificationStatus])
  @@index([institutionId, studentProfileId])
  @@index([institutionId, activityId])
  @@index([institutionId, departmentId])
  @@index([institutionId, category])
}

// --------------------------------------------------
// 8. EVIDENCE FILE (PRIVATE OBJECT STORAGE METADATA)
// --------------------------------------------------

model EvidenceFile {
  id               String   @id @default(cuid())
  institutionId    String
  recordId         String
  originalFilename String
  storedFilename   String   @unique
  storagePath      String
  mimeType         String
  fileSize         Int
  fileDisplaySize  String
  uploadedByUserId String
  sha256Checksum   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  record      ParticipationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  uploadedBy  User                @relation("UserUploadedFiles", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([institutionId, recordId])
}

// --------------------------------------------------
// 9. VERIFICATION REVIEW (IMMUTABLE AUDIT DECISION)
// --------------------------------------------------

model VerificationReview {
  id                 String             @id @default(cuid())
  institutionId      String
  recordId           String
  reviewerUserId     String
  reviewerName       String
  reviewerDepartment String?
  previousStatus     VerificationStatus
  newStatus          VerificationStatus
  decisionNotes      String
  reviewedAt         DateTime           @default(now())

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  record      ParticipationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  reviewer    User                @relation("ReviewerUser", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([institutionId, recordId])
  @@index([institutionId, reviewerUserId])
}

// --------------------------------------------------
// 10. AUDIT LOG (APPEND-ONLY REPOSITORY)
// --------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String?
  actorUserId   String?
  actorEmail    String
  actorRole     String
  ipAddress     String?
  userAgent     String?
  action        String // e.g. "RECORD_VERIFIED", "STUDENT_CREATED"
  resourceType  String // e.g. "ParticipationRecord", "StudentProfile"
  resourceId    String
  beforeState   Json?
  afterState    Json?
  reason        String?
  timestamp     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  actor       User?        @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([institutionId, timestamp])
  @@index([resourceType, resourceId])
  @@index([actorEmail])
}

// --------------------------------------------------
// 11. NOTIFICATION
// --------------------------------------------------

model Notification {
  id              String           @id @default(cuid())
  institutionId   String
  recipientUserId String?
  recipientRole   Role?
  title           String
  message         String
  type            NotificationType @default(info)
  read            Boolean          @default(false)
  targetPage      String?
  recordId        String?
  createdAt       DateTime         @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  recipient   User?       @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([institutionId, recipientUserId, read])
  @@index([institutionId, createdAt])
}

// --------------------------------------------------
// 12. INVITATION (ONBOARDING)
// --------------------------------------------------

model Invitation {
  id              String           @id @default(cuid())
  institutionId   String
  email           String
  role            Role             @default(FACULTY_COORDINATOR)
  departmentId    String?
  token           String           @unique
  invitedByUserId String
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  invitedBy   User        @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([institutionId, status])
  @@index([token])
}

// --------------------------------------------------
// 13. SUBSCRIPTION & BILLING EVENTS
// --------------------------------------------------

model Subscription {
  id                     String             @id @default(cuid())
  institutionId          String             @unique
  plan                   SubscriptionPlan   @default(CAMPUS_PRO)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  maxStudents            Int                @default(2000)
  maxActivities          Int                @default(500)
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  institution Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  events      SubscriptionEvent[]

  @@index([status])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  eventType      String
  provider       String       @default("stripe")
  eventId        String       @unique // for webhook idempotency
  payload        Json
  status         String       @default("PROCESSED")
  processedAt    DateTime     @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([eventId])
}
