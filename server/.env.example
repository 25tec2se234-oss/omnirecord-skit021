# ===================================================
# PEHCHAAN BACKEND ENVIRONMENT CONFIGURATION (SAMPLE)
# ===================================================
# Copy this file to .env and configure the values for your environment.

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,https://pehchaan-skit021.onrender.com

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/pehchaan?schema=public

# Session & Token Security
# Generate secure keys using: openssl rand -base64 32
SESSION_SECRET=replace_with_a_long_random_session_secret_at_least_32_characters
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_characters
COOKIE_NAME=pehchaan_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_MS=86400000

# Private Evidence File Storage
# Mode: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads/evidence
MAX_FILE_SIZE_BYTES=10485760

# Optional S3-compatible configuration (Render / AWS / Cloudflare R2)
# S3_BUCKET=pehchaan-evidence
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=placeholder_key_id
# S3_SECRET_ACCESS_KEY=placeholder_secret_key

# Institutional Initial Admin Seed
INITIAL_ADMIN_EMAIL=studentaffairs@skit.ac.in
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin2024!
INITIAL_INSTITUTION_CODE=SKIT-021
INITIAL_INSTITUTION_NAME=Swami Keshvanand Institute of Technology, Management & Gramothan
INITIAL_PORTAL_ID=SKIT021-EDU-CLOUD
